# Copy to .env (or enter the keys in Settings > Data providers). Keys are stored only in
# this local file - never in the settings JSON, the database or any report.

# FRED API key (free: https://fred.stlouisfed.org/docs/api/api_key.html)
# Enables TRUE point-in-time macro data via ALFRED vintages (publication dates + revisions).
# Without it, the public FRED CSV (latest vintage) is used with conservative release lags and
# the leakage audit reports the remaining revision risk.
FRED_API_KEY=

# Optional market-data fallbacks (used only if yfinance and Stooq fail)
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=

# Optional news API (RSS / official feeds work without a key)
NEWSAPI_KEY=

# Optional: Claude rewrites the explanation from the structured JSON only.
# Every number in the LLM text is checked against the JSON; untraceable numbers -> rejected.
ANTHROPIC_API_KEY=

# Optional: where the database, model artifacts, logs and reports are stored
# VUSA_DATA_DIR=C:\VUSA\storage
